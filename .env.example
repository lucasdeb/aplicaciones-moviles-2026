# Leave empty for local development: use the Expo server host on port 3000.
# Set an explicit HTTPS URL for a deployed backend or custom address/port.
EXPO_PUBLIC_API_URL=

# Real EAS project UUID; configure credentials before building for a phone.
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_ANDROID_PACKAGE=
EXPO_PUBLIC_IOS_BUNDLE_ID=

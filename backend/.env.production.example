NODE_ENV=production
DATABASE_URL=file:/data/whatnext.db
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=3000
UPLOAD_DIR=/data/uploads
BACKUP_DIR=/data/backups
CORS_ORIGINS=https://your-web-app.example
TMDB_KEY=
TMDB_CRON=0 4 * * *
TMDB_SYNC_MAX_PAGES=5
# Optional enhanced security for Expo Push Service. Keep this server-side.
EXPO_ACCESS_TOKEN=
# Optional dedicated OpenStreetMap Overpass endpoint.
OVERPASS_URL=
